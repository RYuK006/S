[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=5
3d/physics_engine="Jolt Physics"
3d/solver/contact_recycle_substeps=2

[rendering]

textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/size=2048
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/use_taa=true
occlusion_culling/use_occlusion_culling=true
lights_and_shadows/positional_shadow/atlas_size=2048
global_illumination/sdfgi/enabled=false
global_illumination/sdfgi/use_occlusion=false
reflections/screen_space_reflections/roughness_limiter=true
